{
  "name": "ayurveda-clinic",
  "private": true,
  "version": "0.1.0",
  "description": "Premium Ayurveda clinic website and admin CMS",
  "scripts": {
    "postinstall": "npm --prefix client install --include=dev",
    "prebuild": "npm --prefix client install --include=dev",
    "install:all": "npm --prefix client install --include=dev",
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server.js",
    "hash-password": "node scripts/hash-password.mjs",
    "check-admin-config": "node scripts/check-admin-config.mjs",
    "preview": "npm --prefix client run preview",
    "test:smoke": "npm --prefix client run test:smoke",
    "test:store": "npm --prefix client run test:store",
    "test:admin": "npm --prefix client run test:admin",
    "test:render": "npm --prefix client run test:render",
    "test:images": "npm --prefix client run test:images",
    "test:auth": "node scripts/test-auth.mjs",
    "test:content": "node scripts/test-content-api.mjs",
    "test:enquiries": "node scripts/test-enquiries-api.mjs",
    "test": "npm run test:auth && npm run test:content && npm run test:enquiries && npm run test:store && npm run test:admin && npm run test:render && npm run test:images && npm run test:smoke"
  }
}
