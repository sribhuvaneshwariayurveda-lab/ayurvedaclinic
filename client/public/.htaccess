<IfModule mod_rewrite.c>
  RewriteEngine On

  # SPA fallback: serve index.html for extensionless client-side routes.
  # Real files and directories (/, /assets/*, /favicon.svg) are served as-is.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]+$
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Long-cache only the hashed Vite assets; never cache the HTML shell.
  <FilesMatch "\.(js|css|woff2?|ttf|otf|png|jpe?g|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
